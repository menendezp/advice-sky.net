# Copy to .env on the machine that runs the sidecar (Droplet). chmod 600. Do not commit .env.
# Production systemd should use this path as BOTH WorkingDirectory secrets source:
#   WorkingDirectory=/opt/agentic-commerce/services/commerce-sidecar
#   EnvironmentFile=-/opt/agentic-commerce/services/commerce-sidecar/.env
# See commerce-sidecar.service.example and ../../deploy/README.md

# Auth for POST /buy-advice and POST /send-payout.
# You generate this yourself (openssl rand -hex 32) — it is not issued by Advice Sky.
# The same value must be in the environment of the agent process that calls the sidecar.
COMMERCE_SIDECAR_TOKEN=

# CDP + x402 — see ../../CDP_WALLET_SETUP.md
CDP_AGENT_ACCOUNT_NAME=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
BASE_RPC_URL=https://mainnet.base.org

# Optional. Sidecar listens on 3847 when unset.
COMMERCE_SIDECAR_PORT=3847

# Optional. Where settled x402 spend is recorded so the $0.10/day cap survives restarts.
# Defaults to ~/.advice-sky/x402-spend.json — set this when the service runs without a HOME.
COMMERCE_SPEND_LEDGER_PATH=

# Optional purchase logging. Leave blank and the sidecar still buys advice and enforces
# the daily cap via the local ledger above. Set both only if you want purchase history in
# Supabase — they are also what lets mint columns on advice_sale_events be updated.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- NFT mint (mintDirective) — most operators leave this whole block blank ---
# NFTs are normally minted to the payer by the Advice Sky store after payment. Only fill
# this in if you run contract-owner mint on your own host. Mint is skipped unless BOTH
# NFT_CONTRACT_ADDRESS and NFT_OWNER_PRIVATE_KEY are set.
NFT_CONTRACT_ADDRESS=
NFT_CHAIN_ID=8453
# Private key for the contract Ownable owner — NEVER commit a real value.
NFT_OWNER_PRIVATE_KEY=
