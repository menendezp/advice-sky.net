# Copy to .env on the machine that runs the sidecar (Droplet). chmod 600. Do not commit .env.
# Production systemd should use this path as BOTH WorkingDirectory secrets source:
#   WorkingDirectory=/opt/agentic-commerce/services/commerce-sidecar
#   EnvironmentFile=-/opt/agentic-commerce/services/commerce-sidecar/.env
# See commerce-sidecar.service.example and openclaw/deploy/digitalocean-systemd.example.service

# Auth for POST /buy-advice and POST /send-payout
COMMERCE_SIDECAR_TOKEN=

# CDP + x402 (same vars as e2e / commerce-agent — see repo root .env.e2e.example)
CDP_AGENT_ACCOUNT_NAME=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
BASE_RPC_URL=https://mainnet.base.org

# Supabase service role (required to update advice_sale_events mint columns after mint)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- NFT mint (mintDirective) — set when you wire Phase 2 on this host ---
# Deployed SkynetAdvisory (same as skynet-nft/.env CONTRACT_ADDRESS)
NFT_CONTRACT_ADDRESS=0xYourDeployedSkynetAdvisoryAddress
NFT_CHAIN_ID=8453
# Private key for contract Ownable owner (same wallet that deployed — NEVER commit real value)
NFT_OWNER_PRIVATE_KEY=
