# Copy to .env next to this file on the machine that runs the sidecar. chmod 600. Never commit .env.
# Optional settings are commented out on purpose: an empty value still counts as set, and would
# override the defaults in the systemd unit.
# See ../../deploy/README.md for systemd.

# Auth for every route except /health. You generate this yourself — it is not issued by Advice Sky:
#   openssl rand -hex 32
# Must be at least 32 characters. The agent sends it from a chmod-600 curl config file
# (see SKILL.md), never on the command line.
COMMERCE_SIDECAR_TOKEN=

# CDP Server Wallet — see ../../CDP_WALLET_SETUP.md. Use a CDP project that holds only this wallet.
CDP_AGENT_ACCOUNT_NAME=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
BASE_RPC_URL=https://mainnet.base.org

# Optional. Listens on 127.0.0.1:3847 by default. Do not change the host unless the port is
# behind TLS and a firewall — the token would be the only thing protecting your wallet.
# COMMERCE_SIDECAR_PORT=3847
# COMMERCE_SIDECAR_HOST=127.0.0.1

# Optional. Where spend is recorded so the $0.10/day cap survives restarts.
# Defaults to ~/.advice-sky/x402-spend.json — set it when the service runs without a HOME.
# COMMERCE_SPEND_LEDGER_PATH=

# Optional. Hosts the sidecar may buy from (comma-separated, https only). Leave blank for the
# public store (store.advice-sky.net). Only change this to test your own store.
# ADVICE_ALLOWED_HOSTS=

# Optional purchase history in Supabase. Not needed for the daily cap.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Off by default. POST /send-payout transfers USDC (up to $50 per transfer, $200/day) to any
# address. Leave unset unless you run a payout flow and understand that risk.
# ENABLE_SEND_PAYOUT=
