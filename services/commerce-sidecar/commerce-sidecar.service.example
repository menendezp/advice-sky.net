# Deploy: copy into systemd and fix paths/User if yours differ.
#   sudo cp services/commerce-sidecar/commerce-sidecar.service.example /etc/systemd/system/commerce-sidecar.service
# Or use the duplicate at: openclaw/deploy/digitalocean-systemd.example.service
#
# Prerequisites (repo root): npm ci && npm run build -w @agentic/commerce-agent

[Unit]
Description=Agentic commerce sidecar (buyAdvice + sendUsdcPayout + optional NFT mint)
After=network.target

[Service]
Type=simple
User=agentic
WorkingDirectory=/opt/agentic-commerce/services/commerce-sidecar
EnvironmentFile=-/opt/agentic-commerce/services/commerce-sidecar/.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
